# Copy to .env and adjust. Never commit real secrets.
# Supabase note: DIRECT_URL is the privileged owner connection (migrations, seed,
# platform-admin path). DATABASE_URL is the RLS-enforced app_tenant role connection
# created by `npm run db:setup-rls` (password below must match that role).

DATABASE_URL=postgresql://app_tenant:CHANGE_ME@localhost:5433/bus?schema=public
DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5433/bus?schema=public
TENANT_DB_PASSWORD=CHANGE_ME

JWT_SECRET=at-least-32-characters-long-random-secret
JWT_ISSUER=bus-api
JWT_AUDIENCE=bus-client
JWT_EXPIRES_IN=15m
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

SEED_SUPER_ADMIN_EMAIL=admin@example.com
SEED_SUPER_ADMIN_PASSWORD=CHANGE_ME

# Passenger OTP (fixed code until an SMS provider is chosen; see specs/002-passenger-auth-flow)
OTP_FIXED_CODE=123456

# Passenger social login (provider app client IDs for idToken audience checks)
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=

# Optional @nestjs/observe telemetry. The agent starts only when BOTH key and
# secret are set — placeholder/missing keys leave telemetry fully disabled.
# OBSERVE_APP_KEY=
# OBSERVE_APP_SECRET=
# OBSERVE_SERVICE_ID=bus

# E2E tests (embedded PostgreSQL by default; must point at localhost)
TEST_DATABASE_URL=postgresql://app_tenant:CHANGE_ME@localhost:5433/bus_test?schema=public
TEST_DIRECT_URL=postgresql://postgres:CHANGE_ME@localhost:5433/bus_test?schema=public
TEST_PG_PORT=5433
