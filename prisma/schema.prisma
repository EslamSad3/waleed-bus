// Prisma 7 schema: URLs live in prisma.config.ts (datasource block carries only the provider).
// Conventions: snake_case tables/columns via @@map/@map so RLS SQL stays idiomatic.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  name            String?   @db.VarChar(255)
  nickname        String?   @db.VarChar(100)
  phoneNumber     String?   @unique @map("phone_number") @db.VarChar(20)
  nationalId      String?   @map("national_id") @db.VarChar(14)
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  picture         String?   @db.VarChar(1024)
  /// Per-user booking seat override (spec 010); null = platform default (5).
  maxBookingSeats Int?      @map("max_booking_seats")
  isActive        Boolean   @default(true) @map("is_active")
  authVersion     Int       @default(1) @map("auth_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  globalRoles    UserRole[]
  memberships    FleetMember[]
  ownedFleets    Fleet[]               @relation("FleetOwner")
  authProviders  UserAuthProvider[]
  otpChallenges  PhoneVerificationChallenge[]
  driverAssignments BusAssignment[]    @relation("AssignmentDriver")
  filedReports   PassengerReport[]    @relation("ReportDriver")
  passengerBookings Booking[]         @relation("PassengerBookings")
  favorites      Favorite[]
  notifications  Notification[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  fleetMembers    FleetMember[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

/// VIP ranking tier for fleet-owner discovery ordering (spec 008).
/// Lower rank surfaces first. Platform-owned catalog data.
model VipTier {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  rank      Int      @unique
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  fleets Fleet[]

  @@map("vip_tiers")
}

model Fleet {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  ownerId   String   @map("owner_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  /// VIP tier for discovery ordering; null = untiered (sorts last).
  vipTierId String?  @map("vip_tier_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User          @relation("FleetOwner", fields: [ownerId], references: [id])
  vipTier  VipTier?      @relation(fields: [vipTierId], references: [id], onDelete: SetNull)
  members  FleetMember[]
  buses    Bus[]
  trips    Trip[]
  bookings Booking[]
  assignments BusAssignment[]
  reports  PassengerReport[]

  @@index([vipTierId])
  @@map("fleets")
}

model FleetMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fleetId   String   @map("fleet_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// ACTIVE | SUSPENDED | REVOKED (validated in the application layer)
  status    String   @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")
  assignedBy String? @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, fleetId])
  @@index([fleetId])
  @@index([roleId])
  @@map("fleet_members")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorFleetId  String?  @map("actor_fleet_id") @db.Uuid
  targetUserId  String?  @map("target_user_id") @db.Uuid
  targetFleetId String?  @map("target_fleet_id") @db.Uuid
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.Uuid
  metadata      Json?
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  success       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

/// Admin-managed vehicle brand dictionary (spec 007).
/// Platform-owned catalog data, like Governorate.
model VehicleBrand {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @unique @db.VarChar(100)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  buses Bus[]

  @@map("vehicle_brands")
}

model Bus {
  id                 String   @id @default(uuid()) @db.Uuid
  fleetId            String   @map("fleet_id") @db.Uuid
  registrationNumber String   @map("registration_number") @db.VarChar(50)
  plateNumber        String?  @map("plate_number") @db.VarChar(50)
  /// Required for new buses (DTO layer); nullable until the backfill
  /// assigns values to pre-existing rows (spec 007).
  color              String?  @db.VarChar(50)
  imageUrl           String?  @map("image_url") @db.VarChar(1024)
  brandId            String?  @map("brand_id") @db.Uuid
  isAirConditioned   Boolean? @map("is_air_conditioned")
  modelYear          Int?     @map("model_year")
  capacity           Int
  lineId             String?  @map("line_id") @db.Uuid
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  fleet Fleet  @relation(fields: [fleetId], references: [id])
  line  Line?  @relation("BusTripLine", fields: [lineId], references: [id], onDelete: SetNull)
  brand VehicleBrand? @relation(fields: [brandId], references: [id], onDelete: Restrict)
  trips Trip[]
  assignments BusAssignment[]

  @@unique([fleetId, registrationNumber])
  @@index([fleetId])
  @@index([lineId])
  @@index([brandId])
  @@map("buses")
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  fleetId     String   @map("fleet_id") @db.Uuid
  busId       String   @map("bus_id") @db.Uuid
  origin      String   @db.VarChar(255)
  destination String   @db.VarChar(255)
  departAt    DateTime @map("depart_at")
  routeId     String?  @map("route_id") @db.Uuid
  fare        Decimal  @default(0) @db.Decimal(10, 2)
  /// SCHEDULED | DEPARTED | COMPLETED | CANCELLED (validated in the application layer)
  status      String   @default("SCHEDULED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bus      Bus       @relation(fields: [busId], references: [id])
  fleet    Fleet     @relation(fields: [fleetId], references: [id])
  route    Route?    @relation(fields: [routeId], references: [id])
  bookings Booking[]
  reports  PassengerReport[]

  @@index([fleetId])
  @@index([busId])
  @@index([routeId])
  @@map("trips")
}

model Booking {
  id             String   @id @default(uuid()) @db.Uuid
  fleetId        String   @map("fleet_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  passengerName  String   @map("passenger_name") @db.VarChar(255)
  passengerPhone String?  @map("passenger_phone") @db.VarChar(30)
  /// SELF | OTHER (validated in the application layer)
  bookingFor     String   @default("SELF") @map("booking_for") @db.VarChar(20)
  /// Free-form note visible wherever booking details are authorized.
  note           String?  @db.VarChar(1000)
  boardingStationId String? @map("boarding_station_id") @db.Uuid
  landingStationId String? @map("landing_station_id") @db.Uuid
  pickupAddress String? @map("pickup_address") @db.VarChar(500)
  pickupLatitude Decimal? @map("pickup_latitude") @db.Decimal(10, 7)
  pickupLongitude Decimal? @map("pickup_longitude") @db.Decimal(10, 7)
  pickupLocationConfirmed Boolean @default(false) @map("pickup_location_confirmed")
  passengerUserId String? @map("passenger_user_id") @db.Uuid
  /// Account that performed the checkout (spec 011 traveler-vs-booker routing).
  /// Equals passengerUserId for SELF bookings; differs for OTHER.
  bookedByUserId String? @map("booked_by_user_id") @db.Uuid
  seats          Int      @default(1)
  /// CONFIRMED | CANCELLED (validated in the application layer)
  status         String   @default("CONFIRMED") @db.VarChar(20)
  totalAmount    Decimal? @map("total_amount") @db.Decimal(10, 2)
  confirmedAt    DateTime @default(now()) @map("confirmed_at")
  cancelledAt    DateTime? @map("cancelled_at")
  cancelledBy    String?   @map("cancelled_by") @db.Uuid
  cancellationReason String? @map("cancellation_reason") @db.VarChar(500)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  // --- driver operational columns (spec 003; all nullable, single-row atomic updates)
  boardedAt      DateTime? @map("boarded_at")
  boardedBy      String?   @map("boarded_by") @db.Uuid
  /// DROPPED_OFF | NOT_DROPPED_OFF (terminal per booking; validated app-layer)
  dropStatus     String?   @map("drop_status") @db.VarChar(20)
  dropStationId  String?   @map("drop_station_id") @db.VarChar(100)
  dropReason     String?   @map("drop_reason") @db.VarChar(500)
  droppedAt      DateTime? @map("dropped_at")
  /// Authoritative method echoed back (driver cannot change the amount — PRD §12)
  paymentMethod  String?   @map("payment_method") @db.VarChar(20)
  /// PAID when collected
  paymentStatus  String?   @map("payment_status") @db.VarChar(20)
  paidAt         DateTime? @map("paid_at")
  paymentMarkedBy String?  @map("payment_marked_by") @db.Uuid
  paymentReference String? @map("payment_reference") @db.VarChar(100)
  refundedAmount Decimal   @default(0) @map("refunded_amount") @db.Decimal(10, 2)
  refundReference String?  @map("refund_reference") @db.VarChar(100)
  paymentNotes   String?   @map("payment_notes") @db.VarChar(500)
  /// Applied promotion snapshot (spec 011). totalAmount stays the value paid.
  promotionId    String?   @map("promotion_id") @db.Uuid
  promoCode      String?   @map("promo_code") @db.VarChar(32)
  discountAmount Decimal    @default(0) @map("discount_amount") @db.Decimal(10, 2)
  /// 1–5, one write per side (validated app-layer)
  busRating      Int?      @map("bus_rating")
  driverRating   Int?      @map("driver_rating")
  passengerRating Int?     @map("passenger_rating")
  busRatedAt     DateTime? @map("bus_rated_at")
  driverRatedAt  DateTime? @map("driver_rated_at")
  passengerRatedAt DateTime? @map("passenger_rated_at")

  trip      Trip      @relation(fields: [tripId], references: [id])
  fleet     Fleet     @relation(fields: [fleetId], references: [id])
  passenger User?     @relation("PassengerBookings", fields: [passengerUserId], references: [id])
  promotion Promotion? @relation("PromotionBookings", fields: [promotionId], references: [id])
  reports   PassengerReport[]
  shares    TripShare[]

  @@index([fleetId])
  @@index([tripId])
  @@index([passengerUserId])
  @@index([boardingStationId])
  @@index([landingStationId])
  @@index([status])
  @@index([paymentStatus])
  @@map("bookings")
}

/// Social identity link: one row per (provider, providerUserId).
/// `provider` is a plain string ('GOOGLE' | 'APPLE', validated app-layer) —
/// never a TypeScript enum (constitution III).
model UserAuthProvider {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_auth_providers")
}

/// Time-bound single-use phone verification demand. One active row per phone
/// (unique phone_number; resend upserts). No code column in the fixed-code
/// phase — verification compares against the OTP_FIXED_CODE constant.
model PhoneVerificationChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @unique @map("phone_number") @db.VarChar(20)
  /// REGISTRATION | PROFILE | PHONE_CHANGE (validated in the application layer)
  purpose     String    @db.VarChar(20)
  userId      String?   @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  lastSentAt  DateTime  @map("last_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_verification_challenges")
}

/// Driver↔bus binding (spec 003). History-preserving: rows are never
/// deleted, only ENDED. Single-active invariants are partial unique indexes
/// (added in the migration — Prisma has no partial-index syntax).
model BusAssignment {
  id           String    @id @default(uuid()) @db.Uuid
  fleetId      String    @map("fleet_id") @db.Uuid
  busId        String    @map("bus_id") @db.Uuid
  driverUserId String    @map("driver_user_id") @db.Uuid
  /// ACTIVE | ENDED (validated in the application layer + DB check constraint)
  status       String    @default("ACTIVE") @db.VarChar(20)
  assignedBy   String?   @map("assigned_by") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  endedAt      DateTime? @map("ended_at")

  fleet  Fleet @relation(fields: [fleetId], references: [id])
  bus    Bus   @relation(fields: [busId], references: [id])
  driver User  @relation("AssignmentDriver", fields: [driverUserId], references: [id])

  @@index([fleetId])
  @@index([busId])
  @@index([driverUserId])
  @@map("bus_assignments")
}

/// Append-only passenger incident record (spec 003, PRD §15 logical record).
/// No update/delete service path exists.
model PassengerReport {
  id          String   @id @default(uuid()) @db.Uuid
  fleetId     String   @map("fleet_id") @db.Uuid
  tripId      String   @map("trip_id") @db.Uuid
  bookingId   String   @map("booking_id") @db.Uuid
  passengerId String?  @map("passenger_id") @db.Uuid
  driverId    String   @map("driver_id") @db.Uuid
  note        String   @db.VarChar(2000)
  /// PENDING | RESOLVED | DISMISSED (validated app-layer)
  status         String    @default("PENDING") @db.VarChar(20)
  resolutionNote String?   @map("resolution_note") @db.VarChar(2000)
  resolvedAt     DateTime? @map("resolved_at")
  resolvedBy     String?   @map("resolved_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at")

  fleet   Fleet   @relation(fields: [fleetId], references: [id])
  trip    Trip    @relation(fields: [tripId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])
  driver  User    @relation("ReportDriver", fields: [driverId], references: [id])

  @@index([fleetId])
  @@index([tripId])
  @@index([bookingId])
  @@index([status])
  @@map("passenger_reports")
}

/// Passenger favorite: fleet owner or individual bus, with optional
/// boarding/landing stop preferences (spec 009). User-owned rows scoped
/// to actor.id at the service layer; RLS self-policy is defense in depth.
/// `type` is FLEET | BUS, validated in the application layer.
model Favorite {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  /// FLEET | BUS (validated in the application layer)
  type              String   @db.VarChar(20)
  fleetId           String?  @map("fleet_id") @db.Uuid
  busId             String?  @map("bus_id") @db.Uuid
  boardingStationId String?  @map("boarding_station_id") @db.Uuid
  landingStationId  String?  @map("landing_station_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fleetId])
  @@unique([userId, busId])
  @@index([userId])
  @@index([userId, type])
  @@map("favorites")
}

/// Promo code catalog (spec 011). Platform-managed via the system path;
/// never fleet-scoped, so no RLS policy (catalog pattern — see check-rls exclusions).
/// `type` is PERCENTAGE (1-100) | FIXED, validated app-layer.
model Promotion {
  id                String    @id @default(uuid()) @db.Uuid
  /// Normalized UPPER-TRIM at write time; unique across the platform.
  code              String    @unique @db.VarChar(32)
  type              String    @db.VarChar(20)
  value             Decimal   @db.Decimal(10, 2)
  /// Caps PERCENTAGE discounts; null = uncapped.
  maxDiscountAmount Decimal?  @map("max_discount_amount") @db.Decimal(10, 2)
  /// True = every user may consume (each up to maxUsesPerUser). False =
  /// only listed PromotionTarget users (no oracle: others see UNKNOWN).
  isGlobal          Boolean   @default(true) @map("is_global")
  /// 1 = once-per-user (default). Platform may raise per code.
  maxUsesPerUser    Int       @default(1) @map("max_uses_per_user")
  /// Null = unlimited platform-wide redemptions.
  maxTotalUses      Int?      @map("max_total_uses")
  startsAt          DateTime? @map("starts_at")
  expiresAt         DateTime? @map("expires_at")
  isActive          Boolean   @default(true) @map("is_active")
  createdByUserId   String?   @map("created_by_user_id") @db.Uuid
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  targets PromotionTarget[]
  usages  PromotionUsage[]
  bookings Booking[] @relation("PromotionBookings")

  @@index([isActive, isGlobal])
  @@map("promotions")
}

/// Allowlist for non-global promotions (spec 011 §109 user segments).
model PromotionTarget {
  promotionId String @map("promotion_id") @db.Uuid
  userId      String @map("user_id") @db.Uuid

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@id([promotionId, userId])
  @@index([userId])
  @@map("promotion_targets")
}

/// One row per booking that consumed a code (spec 011). Rows survive booking
/// cancellation as audit truth; exactly one code per booking (no stacking).
model PromotionUsage {
  id             String   @id @default(uuid()) @db.Uuid
  promotionId    String   @map("promotion_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  bookingId      String   @unique @map("booking_id") @db.Uuid
  discountAmount Decimal  @map("discount_amount") @db.Decimal(10, 2)
  createdAt      DateTime @default(now()) @map("created_at")

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Restrict)

  @@index([promotionId])
  @@index([userId])
  @@map("promotion_usages")
}

/// User inbox row (spec 012). Category: BOOKING | PAYMENT | TRIP | PROMO | SYSTEM.
/// Emitted server-side only; readers are strictly actor-scoped.
model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  category  String    @db.VarChar(20)
  title     String    @db.VarChar(200)
  body      String    @db.VarChar(2000)
  /// Id-only payload (bookingId/tripId/code); no extra PII.
  data      Json?     @db.JsonB
  /// Idempotency key; re-emit with the same key returns the existing row.
  dedupeKey String?   @unique @map("dedupe_key") @db.VarChar(128)
  isRead    Boolean   @default(false) @map("is_read")
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead, createdAt])
  @@map("notifications")
}

/// Dashboard-managed customer-service / ads entries (spec 013). Single global
/// ordered list; `type` is PHONE | WHATSAPP | WEBSITE (validated app-layer).
/// Platform-managed catalog: no RLS policy (see check-rls exclusions).
model ServiceConfigEntry {
  id        String   @id @default(uuid()) @db.Uuid
  text      String   @db.VarChar(200)
  type      String   @db.VarChar(20)
  value     String   @db.VarChar(500)
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([isActive, sortOrder])
  @@map("service_config_entries")
}

/// Generic DB-backed rate-limit bucket. Keys: login:phone:<n>,
/// login:ip:<ip>, otp:send:<phone>, otp:verify:<challengeId>.
model ThrottleCounter {
  key         String   @db.VarChar(128)
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([key])
  @@map("throttle_counters")
}

model Route {
  id           String   @id @default(uuid()) @db.Uuid
  lineId       String   @map("line_id") @db.Uuid
  /// OUTBOUND | RETURN. Both directions own their stop ordering independently.
  direction    String   @default("OUTBOUND") @db.VarChar(20)
  name         String   @db.VarChar(255)
  code         String   @db.VarChar(50)
  origin       String   @db.VarChar(255)
  destination  String   @db.VarChar(255)
  qrIdentifier String   @unique @map("qr_identifier") @db.VarChar(100)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  trips    Trip[]
  line     Line           @relation(fields: [lineId], references: [id], onDelete: Cascade)
  stations RouteStation[]

  @@unique([code])
  @@unique([lineId, direction])
  @@index([lineId])
  @@map("routes")
}

/// Commercial two-way service. Its child Routes are the independent travel
/// directions; buses are assigned here, while Trips select one child Route.
model Line {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  code      String   @unique @db.VarChar(50)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  directions Route[]
  buses      Bus[] @relation("BusTripLine")

  @@map("lines")
}

model Governorate {
  id        String   @id @default(uuid()) @db.Uuid
  code      String   @unique @db.VarChar(30)
  nameAr    String   @map("name_ar") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  stations Station[]
  markazes Markaz[]

  @@map("governorates")
}

/// District/Markaz: second level of the geographic hierarchy
/// (spec 006). Platform-owned catalog data, like Governorate.
model Markaz {
  id            String      @id @default(uuid()) @db.Uuid
  governorateId String      @map("governorate_id") @db.Uuid
  code          String      @unique @db.VarChar(50)
  nameAr        String      @map("name_ar") @db.VarChar(100)
  nameEn        String      @map("name_en") @db.VarChar(100)
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  governorate Governorate @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  localities  Locality[]

  @@index([governorateId])
  @@map("markazes")
}

/// City/Village locality: generic third level of the geographic hierarchy
/// (spec 006). `type` is CITY | VILLAGE, validated in the application layer.
model Locality {
  id        String   @id @default(uuid()) @db.Uuid
  markazId  String   @map("markaz_id") @db.Uuid
  nameAr    String   @map("name_ar") @db.VarChar(100)
  nameEn    String   @map("name_en") @db.VarChar(100)
  /// CITY | VILLAGE (validated in the application layer)
  type      String   @db.VarChar(20)
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  markaz   Markaz    @relation(fields: [markazId], references: [id], onDelete: Restrict)
  stations Station[]

  @@index([markazId])
  @@map("localities")
}

model Station {
  id            String      @id @default(uuid()) @db.Uuid
  name          String      @db.VarChar(255)
  address       String?     @db.VarChar(500)
  latitude      Decimal?    @db.Decimal(10, 7)
  longitude     Decimal?    @db.Decimal(10, 7)
  governorateId String      @map("governorate_id") @db.Uuid
  /// Physical stop's locality (spec 006). Nullable during the backfill
  /// transition; every station must reference a locality whose markaz
  /// belongs to the station's governorate.
  localityId    String?     @map("locality_id") @db.Uuid
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  governorate Governorate   @relation(fields: [governorateId], references: [id], onDelete: Restrict)
  locality    Locality?     @relation(fields: [localityId], references: [id], onDelete: Restrict)
  routes     RouteStation[]

  @@index([governorateId])
  @@index([localityId])
  @@map("stations")
}

model RouteStation {
  id                   String   @id @default(uuid()) @db.Uuid
  routeId              String   @map("route_id") @db.Uuid
  stationId            String   @map("station_id") @db.Uuid
  stopOrder            Int      @map("stop_order")
  estimatedStopMinutes Int?     @map("estimated_stop_minutes")
  /// New API writes accept BOARDING | LANDING only (BOTH rejected at the DTO
  /// layer). The database default intentionally stays BOTH so system-path and
  /// legacy rows without an explicit type keep working until the production
  /// backfill converts every BOTH row (spec 006 follow-up).
  stopType             String   @default("BOTH") @map("stop_type") @db.VarChar(20)
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  route   Route   @relation(fields: [routeId], references: [id], onDelete: Cascade)
  station Station @relation(fields: [stationId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopOrder])
  @@unique([routeId, stationId])
  @@index([stationId])
  @@map("route_stations")
}

model TripShare {
  id               String    @id @default(uuid()) @db.Uuid
  bookingId        String    @map("booking_id") @db.Uuid
  verificationCode String    @map("verification_code") @db.VarChar(10)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  viewCount        Int       @default(0) @map("view_count")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([expiresAt])
  @@map("trip_shares")
}
