// Prisma 7 schema: URLs live in prisma.config.ts (datasource block carries only the provider).
// Conventions: snake_case tables/columns via @@map/@map so RLS SQL stays idiomatic.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String?   @unique @db.VarChar(255)
  passwordHash    String?   @map("password_hash") @db.VarChar(255)
  name            String?   @db.VarChar(255)
  phoneNumber     String?   @unique @map("phone_number") @db.VarChar(20)
  phoneVerifiedAt DateTime? @map("phone_verified_at")
  picture         String?   @db.VarChar(1024)
  isActive        Boolean   @default(true) @map("is_active")
  authVersion     Int       @default(1) @map("auth_version")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  sessions       Session[]
  globalRoles    UserRole[]
  memberships    FleetMember[]
  ownedFleets    Fleet[]               @relation("FleetOwner")
  authProviders  UserAuthProvider[]
  otpChallenges  PhoneVerificationChallenge[]

  @@map("users")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @db.VarChar(100)
  slug        String   @unique @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  fleetMembers    FleetMember[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique @db.VarChar(100)
  resource    String   @db.VarChar(100)
  action      String   @db.VarChar(100)
  description String?  @db.VarChar(500)
  isSystem    Boolean  @default(false) @map("is_system")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String?  @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}

model Fleet {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(255)
  ownerId   String   @map("owner_id") @db.Uuid
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  owner    User          @relation("FleetOwner", fields: [ownerId], references: [id])
  members  FleetMember[]
  buses    Bus[]
  trips    Trip[]
  bookings Booking[]

  @@map("fleets")
}

model FleetMember {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  fleetId   String   @map("fleet_id") @db.Uuid
  roleId    String   @map("role_id") @db.Uuid
  /// ACTIVE | SUSPENDED | REVOKED (validated in the application layer)
  status    String   @db.VarChar(20)
  joinedAt  DateTime @default(now()) @map("joined_at")
  assignedBy String? @map("assigned_by") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  fleet Fleet @relation(fields: [fleetId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@unique([userId, fleetId])
  @@index([fleetId])
  @@index([roleId])
  @@map("fleet_members")
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at")
  revokedAt        DateTime? @map("revoked_at")
  ip               String?   @db.VarChar(45)
  userAgent        String?   @map("user_agent") @db.VarChar(255)
  createdAt        DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model AuditLog {
  id            String   @id @default(uuid()) @db.Uuid
  actorUserId   String?  @map("actor_user_id") @db.Uuid
  actorFleetId  String?  @map("actor_fleet_id") @db.Uuid
  targetUserId  String?  @map("target_user_id") @db.Uuid
  targetFleetId String?  @map("target_fleet_id") @db.Uuid
  action        String   @db.VarChar(100)
  resource      String   @db.VarChar(100)
  resourceId    String?  @map("resource_id") @db.Uuid
  metadata      Json?
  ip            String?  @db.VarChar(45)
  userAgent     String?  @map("user_agent") @db.VarChar(255)
  success       Boolean  @default(true)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([actorUserId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Bus {
  id                 String   @id @default(uuid()) @db.Uuid
  fleetId            String   @map("fleet_id") @db.Uuid
  registrationNumber String   @map("registration_number") @db.VarChar(50)
  plateNumber        String?  @map("plate_number") @db.VarChar(50)
  capacity           Int
  isActive           Boolean  @default(true) @map("is_active")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  fleet Fleet  @relation(fields: [fleetId], references: [id])
  trips Trip[]

  @@unique([fleetId, registrationNumber])
  @@index([fleetId])
  @@map("buses")
}

model Trip {
  id          String   @id @default(uuid()) @db.Uuid
  fleetId     String   @map("fleet_id") @db.Uuid
  busId       String   @map("bus_id") @db.Uuid
  origin      String   @db.VarChar(255)
  destination String   @db.VarChar(255)
  departAt    DateTime @map("depart_at")
  /// SCHEDULED | DEPARTED | COMPLETED | CANCELLED (validated in the application layer)
  status      String   @default("SCHEDULED") @db.VarChar(20)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  bus      Bus       @relation(fields: [busId], references: [id])
  fleet    Fleet     @relation(fields: [fleetId], references: [id])
  bookings Booking[]

  @@index([fleetId])
  @@index([busId])
  @@map("trips")
}

model Booking {
  id             String   @id @default(uuid()) @db.Uuid
  fleetId        String   @map("fleet_id") @db.Uuid
  tripId         String   @map("trip_id") @db.Uuid
  passengerName  String   @map("passenger_name") @db.VarChar(255)
  passengerPhone String?  @map("passenger_phone") @db.VarChar(30)
  seats          Int      @default(1)
  /// CONFIRMED | CANCELLED (validated in the application layer)
  status         String   @default("CONFIRMED") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  trip  Trip  @relation(fields: [tripId], references: [id])
  fleet Fleet @relation(fields: [fleetId], references: [id])

  @@index([fleetId])
  @@index([tripId])
  @@map("bookings")
}

/// Social identity link: one row per (provider, providerUserId).
/// `provider` is a plain string ('GOOGLE' | 'APPLE', validated app-layer) —
/// never a TypeScript enum (constitution III).
model UserAuthProvider {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(20)
  providerUserId String   @map("provider_user_id") @db.VarChar(255)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("user_auth_providers")
}

/// Time-bound single-use phone verification demand. One active row per phone
/// (unique phone_number; resend upserts). No code column in the fixed-code
/// phase — verification compares against the OTP_FIXED_CODE constant.
model PhoneVerificationChallenge {
  id          String    @id @default(uuid()) @db.Uuid
  phoneNumber String    @unique @map("phone_number") @db.VarChar(20)
  /// REGISTRATION | PROFILE | PHONE_CHANGE (validated in the application layer)
  purpose     String    @db.VarChar(20)
  userId      String?   @map("user_id") @db.Uuid
  expiresAt   DateTime  @map("expires_at")
  attempts    Int       @default(0)
  consumedAt  DateTime? @map("consumed_at")
  lastSentAt  DateTime  @map("last_sent_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("phone_verification_challenges")
}

/// Generic DB-backed rate-limit bucket. Keys: login:phone:<n>,
/// login:ip:<ip>, otp:send:<phone>, otp:verify:<challengeId>.
model ThrottleCounter {
  key         String   @db.VarChar(128)
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@id([key])
  @@map("throttle_counters")
}
